# 复制成 .env 再填值：  copy .env.example .env
# .env 放在项目根目录（本项目读的就是这里），已被 .gitignore 忽略，不要提交。
# 只有标【必填】的 6 个键被 secretary/ 用到；其余是给 verify/ 与部署脚本用的。

# ---- 业务库（只读；secretary/config.py 用前 4 个）----
DB_HOST=            # 【必填】业务库地址
DB_PORT=3306        # 【必填】
DB_USER=            # 【必填】
DB_PASSWORD=        # 【必填】
DB_NAME=            # 库名，代码里固定用 dlj_data
DB_SCHEMA=          # 同上
DB_DIALECT=
DB_SSLMODE=
DB_POOL_SIZE=
DB_MAX_OVERFLOW=
DB_QUERY_TIMEOUT_MS=
DB_MAX_ROWS=200

# ---- 模型端点（secretary/config.py 用这两个）----
LLM_BASE_URL=       # 【必填】OpenAI 兼容端点，形如 https://xxx/v1
LLM_API_KEY=        # 【必填】
LLM_MODEL_ROUTER=
LLM_MODEL_ANSWER=
LLM_TEMPERATURE=0
LLM_TIMEOUT_MS=
LLM_ROUTER_TIMEOUT_MS=
LLM_MAX_TOKENS=

# ---- 应用（示例应用用）----
APP_ENV=
APP_HOST=
APP_PORT=
APP_LOG_LEVEL=
APP_AUTH_TOKEN=
APP_MAX_QUESTION_CHARS=
APP_AUDIT_LOG=

# ---- 部署服务器（只有 _probe_* 侦察脚本会读，注意这两个是凭据）----
SERVER_HOST=
SERVER_USER=
SERVER_PASSWORD=
SERVER_SSH_PASSWORD=
SERVER_PORT=22
SERVER_PUBLIC_BASE_URL=
SERVER_WORKERS=
SERVER_HTTPS_ENABLED=
SERVER_SECRET_NAME=

# ---- 本服务的运行时开关（可选，不填用默认值）----
# SECRETARY_HOST=0.0.0.0     监听地址，默认 127.0.0.1
# SECRETARY_PORT=8200
# SECRETARY_MODEL=qwen3.8-max
# SECRETARY_ENV=             指定另一个 .env 路径（默认项目根目录）
# SECRETARY_KB_AGENT=aid-72fa8cae2b124d819617f157e97d0a1d
# SECRETARY_KB_IDS=r57xtq9ypm
# SECRETARY_TABLES=          限定可查的表，逗号分隔；空=用字典里登记的全部
# SECRETARY_MAX_STEPS=0      工具步数上限，0=不限
