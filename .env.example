# 复制成 .env 再填值：  copy .env.example .env
# .env 放在项目根目录（secretary/config.py 读的就是这里），**含凭据，不要提交**。
# 只有标【必填】的 6 个键会被服务用到；其余是给其它脚本用的，留空无妨。

# ---- 业务库（只读；只用到前 4 个）----
DB_HOST=            # 【必填】业务库地址
DB_PORT=3306        # 【必填】
DB_USER=            # 【必填】
DB_PASSWORD=        # 【必填】
DB_NAME=            # 库名，代码里固定用 dlj_data
DB_SCHEMA=          # 同上
DB_DIALECT=
DB_SSLMODE=
DB_POOL_SIZE=
DB_MAX_OVERFLOW=
DB_QUERY_TIMEOUT_MS=
DB_MAX_ROWS=200

# ---- 模型端点 ----
LLM_BASE_URL=       # 【必填】OpenAI 兼容端点，形如 https://xxx/v1
LLM_API_KEY=        # 【必填】
LLM_MODEL_ROUTER=
LLM_MODEL_ANSWER=
LLM_TEMPERATURE=0
LLM_TIMEOUT_MS=
LLM_ROUTER_TIMEOUT_MS=
LLM_MAX_TOKENS=

# ---- 应用 ----
APP_ENV=
APP_HOST=
APP_PORT=
APP_LOG_LEVEL=
APP_AUTH_TOKEN=
APP_MAX_QUESTION_CHARS=
APP_AUDIT_LOG=

# ---- 部署服务器（只有侦察脚本会读；SERVER_PASSWORD / SERVER_SSH_PASSWORD 是凭据）----
SERVER_HOST=
SERVER_USER=
SERVER_PASSWORD=
SERVER_SSH_PASSWORD=
SERVER_PORT=22
SERVER_PUBLIC_BASE_URL=
SERVER_WORKERS=
SERVER_HTTPS_ENABLED=
SERVER_SECRET_NAME=

# ---- 本服务的运行时开关（可选，不填用默认值）----
# SECRETARY_HOST=0.0.0.0     监听地址，默认 127.0.0.1
# SECRETARY_PORT=8200
# SECRETARY_MODEL=qwen3.8-max
# SECRETARY_ENV=             指定另一个 .env 路径（默认项目根目录）
# SECRETARY_TABLES=          限定可查的表，逗号分隔；空=用字典里登记的全部
# SECRETARY_MAX_STEPS=0      工具步数上限，0=不限
# SECRETARY_API_MAX_ROWS=5000  历史接口「全部返回」时的防呆上限（见《接口对接说明.md》）

# ---- ★ 检索面：问答与补全检索哪些知识库（⚠️ 下面这几行写在本文件里【不生效】）----
# config.py 用 os.environ.get() 读这几个键，只是列在这里备忘。
# 生效方式：① systemd 单元里加 Environment=SECRETARY_KB_IDS=...  ② 启动前 set 环境变量。
#   检索服务：aid-72fa8cae2b124d819617f157e97d0a1d
#   检索范围：r57xtq9ypm（ai大脑通用语义知识库）, razubo7dra（个人知识库）
# ⚠️ 只改 KB_IDS 换不了库 —— 目标库必须先在百炼控制台加进该检索服务的绑定范围，否则 401。
# SECRETARY_KB_AGENT=aid-72fa8cae2b124d819617f157e97d0a1d
# SECRETARY_KB_IDS=r57xtq9ypm,razubo7dra

# ---- 2.0 新增：对话记录（可选，都有默认值）----
# 记录写到哪个库。**该库需要先建表**（见交付的 agent_data_建表.sql），
# 用的是同一台 MySQL、同一个账号，只是库名不同。
SECRETARY_AGENT_DB=agent_data

# 多轮上下文：同一场会话里把最近 N 轮问答带上（默认 5）。
# 作用：听懂「那售电量呢」这类省略主语的追问；本轮没提时间/地点时沿用上一轮。
# 设 0 = 关闭，回到「每次提问完全独立」的老行为。
# SECRETARY_HISTORY_TURNS=5

# 整个记录功能的总开关：设 0 后服务照跑，只是不留任何对话记录。
# 什么时候用：记录库还没建好、或者临时不想写库时。
# SECRETARY_QA_LOG=0

# 纠错与名称归一的总开关（默认开）。词典缺失时本能力会自动降级，不用手动关。
# SECRETARY_NAMEFIX=0

# ---- 2.0 起：纠错词典的数据源 ----
# 词典默认【从数据库读】—— 6 张 t_nc_* 表建在 agent_data：
#   建表  tools/lexicon_schema.sql
#   导入  tools/import_lexicon.py    （数据源是工作区根目录的 lexicon_seed/，不在部署包内）
#   校验  tools/verify_lexicon.py
# 部署包里因此【不含词典数据】，3.8MB -> 约 0.3MB。
#
#   db   = 从数据库读（默认）。服务启动时一次性把 4.5 万行词典全量载入内存建索引，
#          之后每次纠错都是纯内存运算，**一条 SQL 都不发**（启动约 1~2 秒，取决于网络）。
#   file = 读 libs/name_correction_lib/data/ 下的 CSV（零依赖，供独立部署或回退用）。
# SECRETARY_LEXICON=db

# 词典库名。默认与对话记录库（SECRETARY_AGENT_DB）同一个库。
# SECRETARY_LEXICON_DB=agent_data

# 词典热更新探测间隔（秒）：人工 UPDATE 完词典，最多等这么久就自动生效，不用重启服务。
# 设 0 = 关闭探测，只在服务启动时加载一次。
# SECRETARY_LEXICON_RECHECK=60

# ---- 4.0 新增：知识库管理（阿里云百炼开放接口）----
# 给同事用的「知识库控制台」在服务页面 /kb：看知识库、看详情、看文档、上传、删除。
# 走的是百炼**开放接口**（注意：不是上面那个问答用的 SECRETARY_KB_AGENT 应用 id）。
# 凭据只存在服务端，**绝不下发前端**。
# 不配这几项也完全不影响问答 —— 只是 /api/kb/** 会返回 503 并说明缺什么。
# 完整说明见《知识库接口文档.md》。
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
WORKSPACE_ID=                 # 业务空间 ID，**必须以 llm- 开头**（别填成知识库 ID 或空间名称）
DEFAULT_INDEX_ID=             # 【管理面】默认知识库 ID；路径里不传 index_id 时用它（现为 razubo7dra 个人知识库）
# BAILIAN_ENDPOINT=bailian.cn-beijing.aliyuncs.com   # 知识库仅支持华北2（北京），一般不用改
# PARSE_TIMEOUT_SECONDS=300   # 上传后等云端解析的最长秒数；超时不算失败（只是先不提交索引任务）
# HTTP_TIMEOUT_SECONDS=120    # 单次调用云端的超时
